local function destroyGunInstances()
    local backpack = getBackpack()
    local old = backpack and backpack:FindFirstChild("Portal Gun")
    if old then old:Destroy() end
    local character = player.Character
    local held = character and character:FindFirstChild("Portal Gun")
    if held then held:Destroy() end
end

local function grantPortalGun()
    if gunObtained then
        setStatus("You already have the Portal Gun", FG_DIM)
        return
    end
    destroyGunInstances()
    local tool = createPortalGun()
    gunObtained = true
    updateGunButtons()
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid and tool then
        humanoid:EquipTool(tool)
    end
    setStatus("Portal Gun ready — tap the ground", ACCENT)
end

local function removePortalGun()
    if not gunObtained then
        setStatus("You don't have the Portal Gun", FG_DIM)
        return
    end
    gunObtained = false
    equipped = false
    destroyGunInstances()
    clearTouchPortals(true)
    stopCoordinateHUD()
    if gunAnimConn then
        gunAnimConn:Disconnect()
        gunAnimConn = nil
    end
    updateGunButtons()
    updateTouchHint()
    setStatus("Portal Gun removed", FG_DIM)
end

