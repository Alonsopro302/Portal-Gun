local function makeDraggable(target, handles, onTap)
    local dragging = false
    local moved = false
    local dragStart = nil
    local startPos = nil

    local function begin(input)
        local inputType = input.UserInputType
        if inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch then return end
        dragging = true
        moved = false
        dragStart = input.Position
        startPos = target.Position
        local conn
        conn = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                conn:Disconnect()
                if not moved and onTap then onTap() end
            end
        end)
    end

    for _, handle in ipairs(handles) do
        handle.InputBegan:Connect(begin)
    end

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - dragStart
        if delta.Magnitude > 6 then moved = true end
        if not moved then return end
        local viewport = gui.AbsoluteSize
        local size = target.AbsoluteSize
        local anchor = target.AnchorPoint
        local offX = startPos.X.Offset + delta.X
        local offY = startPos.Y.Offset + delta.Y
        local left = startPos.X.Scale * viewport.X + offX - anchor.X * size.X
        local top = startPos.Y.Scale * viewport.Y + offY - anchor.Y * size.Y
        local maxLeft = math.max(0, viewport.X - size.X)
        local maxTop = math.max(0, viewport.Y - size.Y)
        offX = offX + (math.clamp(left, 0, maxLeft) - left)
        offY = offY + (math.clamp(top, 0, maxTop) - top)
        target.Position = UDim2.new(startPos.X.Scale, offX, startPos.Y.Scale, offY)
    end)
end

local function minimizeMenu()
    if not bubblePlaced then
        local viewport = gui.AbsoluteSize
        bubble.Position = UDim2.fromOffset(viewport.X * 0.5, viewport.Y * 0.5)
        bubblePlaced = true
    end
    main.Visible = false
    bubble.Size = UDim2.fromOffset(20, 20)
    bubble.Visible = true
    tween(bubble, 0.3, { Size = UDim2.fromOffset(54, 54) }, Enum.EasingStyle.Back)
end

local function restoreMenu()
    bubble.Visible = false
    main.Visible = true
end

