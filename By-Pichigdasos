local function collectInvParts()
    invParts = {}
    local char = player.Character
    if not char then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d.Transparency == 0 then
            invParts[#invParts + 1] = d
        end
    end
end

local function setInvisibility(on)
    invisOn = on
    if on then
        collectInvParts()
        for _, p in ipairs(invParts) do
            if p and p.Parent then
                p.Transparency = 0.5
            end
        end
        if invLoopConn then
            pcall(function() invLoopConn:Disconnect() end)
        end
        invLoopConn = RunService.Heartbeat:Connect(function()
            if not invisOn then return end
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hrp and hum then
                local origCF = hrp.CFrame
                local origOffset = hum.CameraOffset
                local farCF = origCF * CFrame.new(0, -200000, 0)
                local pos = farCF:ToObjectSpace(CFrame.new(origCF.Position)).Position
                hrp.CFrame = farCF
                hum.CameraOffset = pos
                RunService.RenderStepped:Wait()
                if hrp and hrp.Parent and hum and hum.Parent then
                    hrp.CFrame = origCF
                    hum.CameraOffset = origOffset
                end
            end
        end)
        setExtraStatus("Invisibility enabled", ACCENT)
    else
        if invLoopConn then
            pcall(function() invLoopConn:Disconnect() end)
            invLoopConn = nil
        end
        for _, p in ipairs(invParts) do
            if p and p.Parent then
                p.Transparency = 0
            end
        end
        invParts = {}
        setExtraStatus("Invisibility disabled", FG_DIM)
    end
    refreshExtraButtons()
end

