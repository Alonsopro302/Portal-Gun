local function applySpeed()
    local hum = getHumanoid()
    if not hum then return end
    if speedOn then
        hum.WalkSpeed = speedBase * speedMultiplier
    else
        hum.WalkSpeed = speedBase
    end
end

local function setSpeed(on)
    speedOn = on
    if on then
        local hum = getHumanoid()
        if hum and hum.WalkSpeed > 0 then
            speedBase = hum.WalkSpeed
        end
        setExtraStatus("Speed enabled", ACCENT)
    else
        setExtraStatus("Speed disabled", FG_DIM)
    end
    applySpeed()
    refreshExtraButtons()
end

local function setSpeedMultiplier(v)
    speedMultiplier = math.clamp(math.floor(v + 0.5), SLIDER_MIN, SLIDER_MAX)
    sliderLabel.Text = "Speed Multiplier: " .. tostring(speedMultiplier)
    local frac = (speedMultiplier - SLIDER_MIN) / (SLIDER_MAX - SLIDER_MIN)
    sliderFill.Size = UDim2.new(frac, 0, 1, 0)
    sliderKnob.Position = UDim2.new(frac, 0, 0.5, 0)
    if speedOn then
        applySpeed()
    end
end

local function updateSliderFromInput(x)
    local trackAbs = sliderTrack.AbsolutePosition
    local trackSize = sliderTrack.AbsoluteSize
    local frac = math.clamp((x - trackAbs.X) / trackSize.X, 0, 1)
    setSpeedMultiplier(SLIDER_MIN + frac * (SLIDER_MAX - SLIDER_MIN))
end

