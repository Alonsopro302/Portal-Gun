local function stopStepIfIdle()
    if #portals == 0 and stepConn then
        stepConn:Disconnect()
        stepConn = nil
    end
end

local function disposePortal(portal, animated)
    if not portal or portal.dead then return end
    portal.dead = true
    local index = table.find(portals, portal)
    if index then table.remove(portals, index) end
    stopStepIfIdle()
    local model = portal.model
    if animated and model.Parent then
        for _, entry in ipairs(portal.grow) do
            tween(entry.part, 0.25, { Size = Vector3.new(entry.size.X, 0.05, 0.05) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        end
        for _, o in ipairs(portal.orbit) do
            tween(o.part, 0.2, { Transparency = 1 })
        end
        tween(portal.light, 0.25, { Brightness = 0 })
        task.delay(0.3, function()
            model:Destroy()
        end)
    else
        model:Destroy()
    end
    if portal.onDispose then
        portal.onDispose()
    end
end

local function stepPortals()
    local t = os.clock()
    local root = getRoot()
    local rootPos = root and root.Position
    for i = #portals, 1, -1 do
        local portal = portals[i]
        if portal and not portal.dead then
            local pcf = portal.cf
            local right = pcf.RightVector
            local up = pcf.UpVector
            local front = pcf.LookVector
            local center = pcf.Position
            local cframes = portal.orbitCFrames
            for j, o in ipairs(portal.orbit) do
                local ang = t * o.speed + o.phase
                cframes[j] = CFrame.new(center + right * (math.cos(ang) * o.a) + up * (math.sin(ang) * o.b) - front * 0.25)
            end
            workspace:BulkMoveTo(portal.orbitParts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
            portal.core.Transparency = 0.55 + math.sin(t * 3 + portal.seed) * 0.12
            portal.light.Brightness = 2.5 + math.sin(t * 4 + portal.seed) * 0.8
            if rootPos and portal.onEnter and not teleportLocked and t - portal.createdAt > 0.6 then
                local rel = pcf:PointToObjectSpace(rootPos)
                if math.abs(rel.Z) < 3 then
                    local nx = rel.X / 3.6
                    local ny = rel.Y / 5.3
                    if nx * nx + ny * ny < 1 then
                        task.spawn(portal.onEnter, portal)
                    end
                end
            end
        end
    end
end

local function createPortal(cf, color, soft, title, subtitle, onEnter, lifetime)
    local model = make("Model", { Name = "PCD3_Portal" }, workspace)
    local grow = {}

    local function disc(name, zOffset, thickness, height, width, discColor, transparency)
        local size = Vector3.new(thickness, height, width)
        local part = make("Part", {
            Name = name,
            Shape = Enum.PartType.Cylinder,
            Size = Vector3.new(thickness, 0.05, 0.05),
            CFrame = cf * CFrame.new(0, 0, zOffset) * CFrame.Angles(0, math.rad(90), 0),
            Color = discColor,
            Material = Enum.Material.Neon,
            Transparency = transparency,
            Anchored = true,
            CanCollide = false,
            CanTouch = false,
            CanQuery = false,
            CastShadow = false
        }, model)
        table.insert(grow, { part = part, size = size })
        return part
    end

    disc("Glow", 0.12, 0.1, 11.8, 8.4, color, 0.78)
    local frame = disc("Frame", 0, 0.24, 10.6, 7, color, 0.05)
    local inner = disc("Inner", -0.05, 0.24, 9.4, 5.9, soft, 0.5)
    local core = disc("Core", -0.1, 0.24, 6.6, 3.9, soft:Lerp(Color3.new(1, 1, 1), 0.6), 0.6)

    local orbit = {}
    local orbitParts = {}
    local orbitCFrames = {}

    local function addOrbit(count, a, b, speed, size, orbitColor)
        for i = 1, count do
            local part = make("Part", {
                Name = "Spark",
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(size, size, size),
                Color = orbitColor,
                Material = Enum.Material.Neon,
                Transparency = 0.1,
                Anchored = true,
                CanCollide = false,
                CanTouch = false,
                CanQuery = false,
                CastShadow = false,
                CFrame = cf
            }, model)
            table.insert(orbit, { part = part, phase = (i / count) * math.pi * 2, a = a, b = b, speed = speed })
            table.insert(orbitParts, part)
            table.insert(orbitCFrames, cf)
        end
    end

    addOrbit(8, 3.55, 5.35, 1.4, 0.38, soft)
    addOrbit(5, 2.2, 3.6, -2, 0.24, Color3.new(1, 1, 1))

    local light = make("PointLight", {
        Color = color,
        Brightness = 2.5,
        Range = 16,
        Shadows = false
    }, frame)

    make("ParticleEmitter", {
        Color = ColorSequence.new(soft),
        LightEmission = 1,
        LightInfluence = 0,
        Rate = 18,
        Lifetime = NumberRange.new(0.5, 1.1),
        Speed = NumberRange.new(0.5, 2),
        SpreadAngle = Vector2.new(180, 180),
        Rotation = NumberRange.new(0, 360),
        RotSpeed = NumberRange.new(-120, 120),
        Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.25),
            NumberSequenceKeypoint.new(1, 0)
        }),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.2),
            NumberSequenceKeypoint.new(1, 1)
        })
    }, inner)

    local billboard = make("BillboardGui", {
        Name = "Mark",
        Size = UDim2.fromOffset(220, 46),
        StudsOffset = Vector3.new(0, 7.6, 0),
        AlwaysOnTop = true,
        MaxDistance = 180,
        LightInfluence = 0,
        ResetOnSpawn = false
    }, frame)

    make("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 26),
        Text = title,
        TextColor3 = color,
        Font = Enum.Font.GothamBold,
        TextSize = 19,
        TextStrokeTransparency = 0.3,
        TextStrokeColor3 = Color3.new(0, 0, 0)
    }, billboard)

    make("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 18),
        Position = UDim2.fromOffset(0, 26),
        Text = subtitle,
        TextColor3 = FG,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextStrokeTransparency = 0.4,
        TextStrokeColor3 = Color3.new(0, 0, 0)
    }, billboard)

    for _, entry in ipairs(grow) do
        tween(entry.part, 0.5, { Size = entry.size }, Enum.EasingStyle.Back)
    end

    local portal = {
        model = model,
        cf = cf,
        grow = grow,
        orbit = orbit,
        orbitParts = orbitParts,
        orbitCFrames = orbitCFrames,
        core = core,
        light = light,
        onEnter = onEnter,
        createdAt = os.clock(),
        seed = math.random() * 6,
        dead = false
    }

    table.insert(portals, portal)
    if not stepConn then
        stepConn = RunService.Heartbeat:Connect(stepPortals)
    end

    if lifetime then
        task.delay(lifetime, function()
            disposePortal(portal, true)
        end)
    end

    return portal
end

local function raycastParams()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filter = {}
    if player.Character then table.insert(filter, player.Character) end
    for _, p in ipairs(portals) do
        table.insert(filter, p.model)
    end
    params.FilterDescendantsInstances = filter
    return params
end

local function computePortalCFrame(hitPos, normal)
    local camera = workspace.CurrentCamera
    local wall = math.abs(normal.Y) < 0.7
    local front
    if wall then
        front = Vector3.new(normal.X, 0, normal.Z)
    else
        local toCam = camera.CFrame.Position - hitPos
        front = Vector3.new(toCam.X, 0, toCam.Z)
    end
    if front.Magnitude < 0.05 then front = Vector3.new(0, 0, -1) end
    front = front.Unit

    local base = wall and (hitPos + front * 0.45) or hitPos
    local groundY = hitPos.Y
    if wall or normal.Y < -0.7 then
        local startPos
        if normal.Y < -0.7 then
            startPos = hitPos - Vector3.new(0, 1, 0)
        else
            startPos = Vector3.new(base.X, hitPos.Y + 2.5, base.Z)
        end
        local down = workspace:Raycast(startPos, Vector3.new(0, -60, 0), raycastParams())
        if down then groundY = down.Position.Y end
    end

    local center = Vector3.new(base.X, groundY + PORTAL_HALF_H + 0.1, base.Z)
    return CFrame.lookAt(center, center + front)
end

local function clearTouchPortals(animated)
    if clearingTouch then return end
    clearingTouch = true
    local e, x = entryPortal, exitPortal
    entryPortal = nil
    exitPortal = nil
    disposePortal(e, animated)
    disposePortal(x, animated)
    touchStage = "Entry"
    clearingTouch = false
    updateTouchHint()
end

local function teleportThroughEntry()
    if teleportLocked or touchStage ~= "Linked" then return end
    local ex = exitPortal
    if not ex or ex.dead then return end
    if not getRoot() then return end
    teleportLocked = true
    flashScreen(ACCENT_SOFT)
    task.wait(0.1)
    if ex and not ex.dead then
        local front = ex.cf.LookVector
        local dest = ex.cf.Position - Vector3.new(0, PORTAL_HALF_H - 3.2, 0) + front * 4
        local root = getRoot()
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = CFrame.lookAt(dest, dest + front)
        end
    end
    task.wait(0.4)
    clearTouchPortals(true)
    teleportLocked = false
end

local function handlePlacement(hitPos, normal)
    if touchStage == "Linked" then
        clearTouchPortals(true)
    end
    local cf = computePortalCFrame(hitPos, normal)
    if touchStage == "Entry" then
        entryPortal = createPortal(cf, ACCENT, ACCENT_SOFT, "» ENTRY »", "Leads to the exit", teleportThroughEntry, PORTAL_LIFETIME)
        entryPortal.onDispose = function() clearTouchPortals(true) end
        touchStage = "Exit"
    else
        if entryPortal and (cf.Position - entryPortal.cf.Position).Magnitude < 9 then
            setStatus("Place the exit farther from portal 1", DANGER)
            return
        end
        exitPortal = createPortal(cf, EXIT_COLOR, EXIT_SOFT, "« EXIT «", "Destination point", nil, PORTAL_LIFETIME)
        exitPortal.onDispose = function() clearTouchPortals(true) end
        touchStage = "Linked"
    end
    updateTouchHint()
end

local function tryPlace(screenPos, isTouch)
    local camera = workspace.CurrentCamera
    if not camera then return end
    local ray
    if isTouch then
        ray = camera:ScreenPointToRay(screenPos.X, screenPos.Y)
    else
        ray = camera:ViewportPointToRay(screenPos.X, screenPos.Y)
    end
    local result = workspace:Raycast(ray.Origin, ray.Direction * 600, raycastParams())
    if result then
        handlePlacement(result.Position, result.Normal)
    end
end

local function makePart(parent, name, size, color, material, cframe)
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.Color = color
    part.Material = material
    part.CFrame = cframe
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Massless = true
    part.CastShadow = false
    part.Parent = parent
    return part
end

local function weldPart(part, handle)
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = handle
    weld.Part1 = part
    weld.Parent = part
end

local function createPortalGun()
    local tool = Instance.new("Tool")
    tool.Name = "Portal Gun"
    tool.RequiresHandle = true
    tool.CanBeDropped = false
    tool.ToolTip = "Tap the ground to create portals"

    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.72, 2.35, 0.72)
    handle.Color = Color3.fromRGB(55, 57, 55)
    handle.Material = Enum.Material.SmoothPlastic
    handle.CanCollide = false
    handle.CanTouch = false
    handle.CanQuery = false
    handle.Massless = true
    handle.CastShadow = false
    handle.Parent = tool

    tool.Grip = CFrame.new(0, -0.05, -0.15) * CFrame.Angles(math.rad(90), 190, math.rad(-90))

    local body = makePart(tool, "MainBody", Vector3.new(3.6, 0.75, 2.1), Color3.fromRGB(150, 150, 145), Enum.Material.SmoothPlastic, handle.CFrame * CFrame.new(-1.55, 1.40, 0))
    weldPart(body, handle)

    local bottom = makePart(tool, "BottomBody", Vector3.new(3.25, 0.18, 1.8), Color3.fromRGB(90, 92, 90), Enum.Material.SmoothPlastic, handle.CFrame * CFrame.new(-1.55, 0.97, 0))
    weldPart(bottom, handle)

    local frontPanel = makePart(tool, "FrontPanel", Vector3.new(0.15, 0.62, 1.75), Color3.fromRGB(65, 67, 65), Enum.Material.SmoothPlastic, handle.CFrame * CFrame.new(-3.37, 1.40, 0))
    weldPart(frontPanel, handle)

    for i = -1, 1 do
        local emitter = Instance.new("Part")
        emitter.Name = "GreenEmitter"
        emitter.Shape = Enum.PartType.Cylinder
        emitter.Size = Vector3.new(0.16, 0.43, 0.43)
        emitter.Color = ACCENT
        emitter.Material = Enum.Material.Neon
        emitter.CanCollide = false
        emitter.CanTouch = false
        emitter.CanQuery = false
        emitter.Massless = true
        emitter.CFrame = handle.CFrame * CFrame.new(-3.46, 1.40, i * 0.55) * CFrame.Angles(0, math.rad(90), 0)
        emitter.Parent = tool
        weldPart(emitter, handle)

        local light = Instance.new("PointLight")
        light.Color = ACCENT
        light.Brightness = 1.5
        light.Range = 4
        light.Shadows = false
