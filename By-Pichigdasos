end)

local function enterGamePortal(portal)
    if teleportLocked or not portal.placeId then return end
    teleportLocked = true
    flashScreen(GAME_SOFT)
    local placeId = portal.placeId
    local gameName = tostring(portal.gameName)
    setStatus("Teleporting to " .. gameName .. "...", GAME_SOFT)
    task.spawn(function()
        local lastErr = "unknown"
        for attempt = 1, 3 do
            local ok1, err1 = pcall(function()
                TeleportService:TeleportAsync(placeId, { player })
            end)
            if ok1 then return end
            lastErr = tostring(err1)
            task.wait(0.8)
            local ok2, err2 = pcall(function()
                TeleportService:Teleport(placeId, player)
            end)
            if ok2 then return end
            lastErr = tostring(err2)
            if attempt < 3 then
                setStatus("Attempt " .. attempt .. " failed, retrying...", FG_DIM)
                task.wait(1.2)
            end
        end
        setStatus("Teleport failed: " .. lastErr .. "\nIf you use Delta Executor, disable \"only teleport to games with the same ID\"", DANGER)
        teleportLocked = false
    end)
end

local function spawnGamePortal(placeId, name)
    local root = getRoot()
    if not root then
        setStatus("Your character is not ready", DANGER)
        return false
    end
    if gamePortal then
        disposePortal(gamePortal, true)
        gamePortal = nil
    end
    local look = root.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 0.05 then flat = Vector3.new(0, 0, -1) end
    flat = flat.Unit
    local pos = root.Position + flat * 10
    local down = workspace:Raycast(pos + Vector3.new(0, 3, 0), Vector3.new(0, -40, 0), raycastParams())
    local groundY = down and down.Position.Y or (pos.Y - 3)
    local center = Vector3.new(pos.X, groundY + PORTAL_HALF_H + 0.1, pos.Z)
    local cf = CFrame.lookAt(center, center - flat)
    local portal = createPortal(cf, GAME_COLOR, GAME_SOFT, "» GAME »", name, enterGamePortal, GAME_PORTAL_LIFETIME)
    portal.placeId = placeId
    portal.gameName = name
    portal.onDispose = function()
        if gamePortal == portal then gamePortal = nil end
    end
    gamePortal = portal
    return true
end

goButton.MouseButton1Click:Connect(function()
    if searching then return end
    local text = string.match(gameBox.Text, "^%s*(.-)%s*$")
    if text == "" then
        setStatus("Enter the game ID", DANGER)
        return
    end

    local numeric = tonumber(text)
    if not numeric or numeric <= 0 or numeric % 1 ~= 0 then
        setStatus("Invalid ID — enter only the numeric game ID", DANGER)
        return
    end

    local placeId = math.floor(numeric)

    searching = true
    goButton.Text = "PREPARING..."
    goButton.BackgroundColor3 = ACCENT_DIM
    setStatus("Getting game info...", FG_DIM)

    task.spawn(function()
        local name = resolveGameName(placeId)
        searching = false
        goButton.Text = "OPEN GAME PORTAL"
        goButton.BackgroundColor3 = ACCENT
        if spawnGamePortal(placeId, name) then
            setStatus("Portal ready → " .. name .. "\nWalk through it to join.", ACCENT)
        else
            setStatus("Could not create the portal (character not ready)", DANGER)
        end
    end)
end)

local pendingTouch = {}
local pendingMouse = nil

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        if main.Visible then
            main.Visible = false
        elseif bubble.Visible then
            restoreMenu()
        else
            main.Visible = true
        end
        return
    end
    if not (gunObtained and equipped) then return end
    if input.KeyCode == Enum.KeyCode.R then
        clearTouchPortals(true)
        return
    end
    local inputType = input.UserInputType
    if inputType == Enum.UserInputType.Touch then
        pendingTouch[input] = { pos = Vector2.new(input.Position.X, input.Position.Y), time = os.clock() }
    elseif inputType == Enum.UserInputType.MouseButton1 then
        pendingMouse = { pos = UserInputService:GetMouseLocation(), time = os.clock() }
    end
end)

UserInputService.InputEnded:Connect(function(input)
    local inputType = input.UserInputType
    if (inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch) and draggingSlider then
        draggingSlider = false
    end
    if inputType == Enum.UserInputType.Touch then
        local info = pendingTouch[input]
        pendingTouch[input] = nil
        if not info or not (gunObtained and equipped) then return end
        local endPos = Vector2.new(input.Position.X, input.Position.Y)
        if (endPos - info.pos).Magnitude < 14 and os.clock() - info.time < 0.45 then
            tryPlace(endPos, true)
        end
    elseif inputType == Enum.UserInputType.MouseButton1 then
        local info = pendingMouse
        pendingMouse = nil
        if not info or not (gunObtained and equipped) then return end
        local endPos = UserInputService:GetMouseLocation()
        if (endPos - info.pos).Magnitude < 14 and os.clock() - info.time < 0.6 then
            tryPlace(endPos, false)
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not draggingSlider then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        updateSliderFromInput(input.Position.X)
    end
end)

